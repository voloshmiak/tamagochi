# Скопіюйте у .env і змініть за потреби. Усі змінні мають значення за
# замовчуванням, тож для першого запуску (docker compose up) .env не потрібен.

# --- API ---
APP_ENV=dev
HTTP_ADDR=:8080
JWT_SECRET=change-me-to-a-long-random-string
# NFR-SEC-03: access не довше 15 хв, refresh не довше 30 днів (720h).
ACCESS_TTL=15m
REFRESH_TTL=720h
BRAIN_SEED=42
# Адреса, яку відкриває користувач; на неї ведуть посилання в листах.
# Для локального запуску без Docker (Vite): http://localhost:5173
PUBLIC_URL=https://localhost:8443
# Атрибут Secure для cookie; за замовчуванням увімкнений скрізь, крім APP_ENV=dev.
# COOKIE_SECURE=true

# --- Сховища (без них API зберігає дані в пам'яті процесу) ---
# Для локального запуску без Docker: postgres://tamagochi:tamagochi@localhost:5432/tamagochi?sslmode=disable
# DATABASE_URL=
# Застосовувати міграції goose під час старту API.
MIGRATE_ON_START=true
# Для локального запуску без Docker: redis://localhost:6379/0
# REDIS_URL=

# --- Пошта (без SMTP_ADDR посилання для підтвердження email пишеться в лог) ---
# SMTP_ADDR=localhost:1025
# SMTP_FROM=Tamagochi <no-reply@tamagochi.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Docker Compose ---
POSTGRES_USER=tamagochi
POSTGRES_PASSWORD=tamagochi
POSTGRES_DB=tamagochi
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
MAILPIT_UI_PORT=8025
# Домен сайту та видавець сертифіката: internal — власний CA Caddy (локально);
# email — сертифікат Let's Encrypt через ACME (продакшн).
SITE_ADDRESS=localhost
TLS_ISSUER=internal
