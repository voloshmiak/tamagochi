{$SITE_ADDRESS:localhost} {
	tls {$TLS_ISSUER:internal} {
		protocols tls1.2 tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' https://listen.reyfm.de; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	encode gzip

	@backend path /api/* /healthz
	handle @backend {
		reverse_proxy {
			dynamic a api 8080 {
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 10s
			header_up X-Real-IP {remote_host}
		}
	}

	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

http://{$SITE_ADDRESS:localhost} {
	redir {$PUBLIC_URL:https://localhost}{uri} 308
}
